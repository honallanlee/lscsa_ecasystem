# Postgres. Vercel fills this in when you connect a Neon database.
DATABASE_URL=

# Any long random text. Needed once, to create the first admin at /setup.
SETUP_TOKEN=

# Optional. Without these two, email buttons are simply switched off.
RESEND_API_KEY=
EMAIL_FROM="ECA Fair <fair@your-domain.example>"

# Optional. Emails stop for the month once this many are sent. Default 20.
EMAIL_MONTHLY_CAP=20
